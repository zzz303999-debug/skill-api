API_HOST=127.0.0.1
API_PORT=9000
# 单文件大小上限（handler 逐文件校验，超限返回 400 file_too_large）
# 超限 413
API_MAX_UPLOAD_BYTES=20971520
API_BATCH_MAX_FILES=10
SKILL_MAX_CONCURRENCY=4
# 在途任务满时新请求排队等待的最长秒数，超时返回 503
SKILL_QUEUE_WAIT_SECONDS=10
# 接口访问凭证（Bearer / X-API-Key）
# 为空时不启用鉴权（仅限可信内网/本地开发）
API_KEY=

# ---- 订单创建接口 ----
# 下游仅需业务数据、userId（由上游经 /orders 透传）与 roomId，无身份凭据
ORDER_API_URL=https://pre-s3.jxt56.com/Car/publishCreateOrder
ORDER_API_TIMEOUT_SECONDS=30

# ---- OpenAI-compatible LLM ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# ---- 模型选择 ----
# 服务端支持的模型名
LLM_MODEL_DEFAULT=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_THINKING_MODE=disabled

# ---- 扫描 PDF 视觉识别 ----
VISION_MAX_PDF_PAGES=10
VISION_PDF_RENDER_SCALE=2.0
# 原图 base64 直传 LLM 的字节数上限；超过则跳过 vision 并标记人工复核
VISION_MAX_IMAGE_BYTES=8388608
# 图片 OCR 高置信时跳过 LLM vision 交叉核验（提速）
IMAGE_VISION_SKIP_WHEN_CONFIDENT=true

# ---- PDF 文本层页级质量探测 ----
PARSER_TEXT_MIN_CHARS=50
PARSER_GARBLED_RATIO_THRESHOLD=0.05

# ---- MinerU PDF/图片解析（Compose 默认启用） ----
# Compose 会同时启动下方的 MinerU 容器；开启后低质量 PDF 页和原始图片调用 MinerU。
MINERU_ENABLED=true
MINERU_BASE_URL=http://mineru:8888
MINERU_ENDPOINT=/file_parse
MINERU_API_KEY=
MINERU_EXPECTED_VERSION=2.5.4
MINERU_TIMEOUT_SECONDS=300
MINERU_FALLBACK_ENABLED=true
MINERU_OCR_CONCURRENCY=4
# 默认由 mineru/Dockerfile 构建 CPU 镜像；此变量是本地镜像标签。
MINERU_VERSION=2.5.4
MINERU_IMAGE=skill-api-mineru:2.5.4
MINERU_MODEL_SOURCE=modelscope
MINERU_SHM_SIZE=8g
# 若镜像的 API 启动命令不同，可在服务器 .env 覆盖。
MINERU_COMMAND=mineru-api --host 0.0.0.0 --port 8888

# ---- 镜像部署（docker-compose.deploy.yml） ----
# 生产必须显式指定具体版本，禁止使用 latest
SKILL_API_IMAGE=ghcr.io/zzz303999-debug/skill-api:v0.1.0

# ---- 健康检查（/healthz） ----
# 依赖可达性探测：只验 LLM/MinerU 可达（不调 chat、不下单）；关闭后 dependencies 返回 skipped
HEALTH_PROBE_ENABLED=true
# 单依赖探测超时（秒）；需低于 Docker healthcheck timeout（5s）
HEALTH_PROBE_TIMEOUT_SECONDS=2

# ---- 存储 ----
STORAGE_DIR=./storage
# 审计（720 = 30 天）；日志按大小自动轮转，旧归档超过该时长被清理
STORAGE_KEEP_HOURS=720

# ---- 请求访问日志（审计） ----
# 是否记录 JSON 请求体内容（如 /orders 的完整请求 JSON）
ACCESS_LOG_RECORD_BODY=true
# 请求体记录的最大字符数，超出截断并标记 body_truncated
ACCESS_LOG_BODY_MAX_CHARS=4096
# 云服务前有 nginx/负载均衡时保持开启；取 X-Forwarded-For 最后一个地址
# （与 nginx `$proxy_add_x_forwarded_for` 追加语义一致，客户端无法伪造）
ACCESS_LOG_TRUST_PROXY=true

# ---- 请求限流（内存滑动窗口，按客户端 IP；仅单进程部署下精确） ----
# 建议开启（true），否则 /orders、/skills/* 等 LLM 密集接口无任何滥用保护；
# 担心误伤正常调用时可调大 RATE_LIMIT_HEAVY_MAX_REQUESTS，而非关闭
RATE_LIMIT_ENABLED=true
# heavy 档（/orders、/skills/* 等 LLM/转换密集型接口）：窗口内最大请求数
RATE_LIMIT_HEAVY_MAX_REQUESTS=10
# heavy 档窗口秒数
RATE_LIMIT_HEAVY_WINDOW_SECONDS=60
# light 档（/api/logs 日志查询）：窗口内最大请求数
RATE_LIMIT_LIGHT_MAX_REQUESTS=120
# light 档窗口秒数
RATE_LIMIT_LIGHT_WINDOW_SECONDS=60
# 免限流 IP 白名单，逗号分隔（如内网网关）；留空则不豁免
RATE_LIMIT_WHITELIST=

# ---- 日志 ----
LOG_LEVEL=INFO
