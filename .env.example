# ---- API 服务 ----
API_HOST=0.0.0.0
API_PORT=8080
API_KEY=change-me-in-prod

# ---- OpenClaw 网关 ----
OPENCLAW_BASE_URL=http://192.168.0.130:18789/v1
OPENCLAW_API_KEY=80a0ebc652b72a3aabaf1f4d96f33876591338c084a5d23d

# ---- 模型选择 ----
# openclaw 网关模型名。网关会代理到底层 provider（DeepSeek 等）
# 如需指定特定 agent 可用 openclaw/<agentId>
LLM_MODEL_DEFAULT=openclaw
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ---- 存储 ----
STORAGE_DIR=./storage
STORAGE_KEEP_HOURS=24

# ---- 日志 ----
LOG_LEVEL=INFO
