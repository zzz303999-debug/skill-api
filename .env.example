# ---- API 服务 ----
API_HOST=0.0.0.0
API_PORT=8080
API_KEY=change-me-in-prod
API_MAX_UPLOAD_BYTES=20971520
API_BATCH_MAX_FILES=10
SKILL_MAX_CONCURRENCY=4

# ---- OpenClaw 网关 ----
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=

# ---- 模型选择 ----
# openclaw 网关模型名。网关会代理到底层 provider（DeepSeek 等）
# 如需指定特定 agent 可用 openclaw/<agentId>
LLM_MODEL_DEFAULT=openclaw
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ---- 扫描 PDF 视觉识别 ----
VISION_MAX_PDF_PAGES=3
VISION_PDF_RENDER_SCALE=2.0

# ---- PDF 文本层页级质量探测 ----
PARSER_TEXT_MIN_CHARS=50
PARSER_GARBLED_RATIO_THRESHOLD=0.05

# ---- MinerU PDF/图片解析（可选） ----
# 开启后仅低质量 PDF 页和原始图片调用 MinerU；失败或低置信时转 vision 并生成复核项。
MINERU_ENABLED=false
MINERU_BASE_URL=http://host.docker.internal:8000
MINERU_ENDPOINT=/file_parse
MINERU_API_KEY=
MINERU_EXPECTED_VERSION=2.5.4
MINERU_TIMEOUT_SECONDS=120
MINERU_FALLBACK_ENABLED=true

# ---- 存储 ----
STORAGE_DIR=./storage
STORAGE_KEEP_HOURS=24

# ---- 日志 ----
LOG_LEVEL=INFO
